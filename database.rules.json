{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".write": "auth != null && auth.uid === $room && (!data.exists() || !newData.exists())",
        ".validate": "newData.hasChildren(['host', 'open', 'at', 'm', 'slots']) && newData.child('host').val() === $room && newData.child('m').child($room).exists() && newData.child('slots/0').val() === $room",
        "host": {
          ".read": "auth != null",
          ".validate": "newData.isString() && newData.val() === $room"
        },
        "open": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $room",
          ".validate": "newData.isBoolean()"
        },
        "at": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "m": {
          ".read": "auth != null && data.child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && (auth.uid === $room || (auth.uid === $uid && (!newData.exists() || data.exists() || root.child('rooms').child($room).child('open').val() === true || root.child('rin').child($room).child(auth.uid).val() === true)))",
            ".validate": "newData.hasChildren(['name', 'dex', 'shiny', 'at']) && (newData.parent().parent().child('slots/0').val() === $uid || newData.parent().parent().child('slots/1').val() === $uid || newData.parent().parent().child('slots/2').val() === $uid || newData.parent().parent().child('slots/3').val() === $uid)",
            "name": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16" },
            "dex": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1025 && newData.val() % 1 === 0" },
            "shiny": { ".validate": "newData.isBoolean()" },
            "at": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "$other": { ".validate": false }
          }
        },
        "slots": {
          ".read": "auth != null",
          "$seat": {
            ".write": "auth != null && $seat.matches(/^[1-3]$/) && (newData.exists() ? (newData.val() === auth.uid && (data.val() === auth.uid || (!data.exists() && root.child('rooms').child($room).child('slots/0').val() !== auth.uid && root.child('rooms').child($room).child('slots/1').val() !== auth.uid && root.child('rooms').child($room).child('slots/2').val() !== auth.uid && root.child('rooms').child($room).child('slots/3').val() !== auth.uid)) && (root.child('rooms').child($room).child('open').val() === true || root.child('rin').child($room).child(auth.uid).val() === true)) : ((data.val() === auth.uid || auth.uid === $room) && !newData.parent().parent().child('m').child(data.val()).exists()))",
            ".validate": "$seat.matches(/^[0-3]$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
          }
        },
        "q": {
          "$recipient": {
            ".read": "auth != null && auth.uid === $recipient && root.child('rooms').child($room).child('m').child(auth.uid).exists()",
            "$slot": {
              ".write": "auth != null && root.child('rooms').child($room).child('m').child(auth.uid).exists() && (newData.exists() ? (root.child('rooms').child($room).child('m').child($recipient).exists() && $slot.matches(/^[A-Za-z0-9_-]+_[0-9]{2}$/) && $slot.beginsWith(auth.uid + '_') && newData.isString() && newData.val().beginsWith('{\"f\":\"' + auth.uid + '\"')) : auth.uid === $recipient)",
              ".validate": "newData.isString() && newData.val().length <= 1048576"
            }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "rin": {
      "$room": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('rooms').child($room).child('open').val() === true || root.child('rooms').child($room).child('m').child(auth.uid).exists())",
          ".validate": "newData.val() === true"
        }
      }
    }
  }
}
