{
  "name": "pokesurvivor-friends-hosting",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:rules": "firebase emulators:exec --project demo-pokesurvivor --only auth,firestore,database \"node --test tests/firebase-rules.test.cjs\"",
    "stage": "node tools/stage-hosting.cjs",
    "deploy": "npm run stage && firebase deploy --only firestore,database,hosting",
    "preview": "npm run stage && firebase emulators:start --only hosting",
    "shots": "node tools/ui-shots.cjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.2.0",
    "firebase-tools": "15.35.0",
    "playwright": "1.65.0"
  },
  "engines": {
    "node": ">=22"
  }
}
